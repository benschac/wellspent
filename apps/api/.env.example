PORT=3001
CORS_ORIGIN=https://wellspent.day,http://localhost:3000,http://localhost:8081
# Optional focus assistant. Credentials remain in the API process.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
# Local Supabase database. Keep hosted database credentials server-only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# ActivityKit updates are opt-in. Use the app bundle ID, not the widget
# extension bundle ID. Encode the downloaded APNs .p8 key with:
# base64 < AuthKey_KEYID.p8 | tr -d '\n'
APPLE_LIVE_ACTIVITY_PUSH_ENABLED=false
APPLE_APNS_ENVIRONMENT=development
APPLE_APNS_BUNDLE_ID=com.benschac.timer
APPLE_APNS_KEY_ID=
APPLE_APNS_TEAM_ID=
APPLE_APNS_PRIVATE_KEY_BASE64=

# Google Calendar is opt-in. Generate the encryption key with:
# openssl rand -base64 32
GOOGLE_CALENDAR_ENABLED=false
# Shared encryption key for both Calendar and Sheets; preserve existing value.
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_WEBHOOK_URL=https://api.wellspent.day/api/integrations/google-calendar/webhook
# Well Spent Web application OAuth client; server-only credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# For local OAuth testing, replace https://api.wellspent.day with http://localhost:3001.
GOOGLE_OAUTH_REDIRECT_URI=https://api.wellspent.day/api/integrations/google-calendar/callback
# Enable after filling the client credentials and encryption key above.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_OAUTH_REDIRECT_URI=https://api.wellspent.day/api/integrations/google-sheets/callback
# Fixed return page after OAuth consent. Use http://localhost:3000/focus locally.
# Leave empty to retain JSON callback responses for API-only clients.
GOOGLE_INTEGRATIONS_RETURN_URL=https://wellspent.day/focus
# Required for the hosted Calendar job endpoint; use at least 16 random characters.
# Vercel Cron and the private queue consumer use it as a Bearer token.
CRON_SECRET=

# Used by the API to validate end-user Supabase access tokens.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=

# Private focus notifications. Apply the focus Realtime policy migration first.
FOCUS_REALTIME_ENABLED=false
# Server-only sb_secret key (local service-role JWT also supported). Never expose to web/native clients.
SUPABASE_SECRET_KEY=
