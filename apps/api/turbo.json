{
  "extends": ["//"],
  "tasks": {
    "dev": {
      "env": ["AI_GATEWAY_API_KEY", "AI_MODEL", "DATABASE_URL"],
      "passThroughEnv": [
        "FOCUS_REALTIME_ENABLED",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "GOOGLE_CALENDAR_*",
        "GOOGLE_SHEETS_*",
        "GOOGLE_OAUTH_*",
        "GOOGLE_INTEGRATIONS_*",
        "CRON_SECRET",
        "VERCEL"
      ]
    },
    "build": {
      "passThroughEnv": [
        "AI_GATEWAY_API_KEY",
        "AI_MODEL",
        "APPLE_APNS_*",
        "APPLE_LIVE_ACTIVITY_PUSH_ENABLED",
        "CORS_ORIGIN",
        "CRON_SECRET",
        "DATABASE_URL",
        "FOCUS_REALTIME_ENABLED",
        "GOOGLE_CALENDAR_*",
        "GOOGLE_INTEGRATIONS_*",
        "GOOGLE_SHEETS_*",
        "GOOGLE_OAUTH_*",
        "PORT",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_URL",
        "VERCEL"
      ]
    }
  }
}
