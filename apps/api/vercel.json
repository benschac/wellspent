{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes bun@1.4.0 install --frozen-lockfile",
  "functions": {
    "api/google-calendar-jobs.mjs": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "google-calendar-jobs",
          "maxConcurrency": 4,
          "maxDeliveries": 8,
          "retryAfterSeconds": 30
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/integrations/google-calendar/jobs/run",
      "schedule": "*/5 * * * *"
    }
  ]
}
