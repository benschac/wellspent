{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "dev": "node ../../scripts/backend-profile.mjs web local",
    "dev:local": "node ../../scripts/backend-profile.mjs web local",
    "dev:prod-api": "node ../../scripts/backend-profile.mjs web prod-api",
    "lint": "biome check .",
    "skia:web": "setup-skia-web public",
    "start": "next start --port 3000",
