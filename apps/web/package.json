    "test:focus": "bun test app/focus",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.88",
    "@radix-ui/react-icons": "1.3.2",
    "@react-three/fiber": "9.7.0",
    "@repo/api-client": "workspace:*",
    "@repo/lib": "workspace:*",
    "@repo/session-domain": "workspace:*",
    "@repo/timer": "workspace:*",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "2.115.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.102.8",
    "ai": "7.0.85",
    "expo-sqlite": "~57.0.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "~6.0.3"
  }
}
