{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/next.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
