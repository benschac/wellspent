{
  "name": "@repo/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:prepare": "node scripts/prepare.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "lint": "biome check .",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
