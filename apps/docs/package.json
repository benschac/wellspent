    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@repo/api-contract": "workspace:*",
    "@repo/api-client": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "chokidar": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  }
