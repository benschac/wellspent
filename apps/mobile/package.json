{
  "name": "@repo/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index",
  "scripts": {
    "android": "node ../../scripts/backend-profile.mjs mobile local -- run:android",
    "build": "expo export --platform all",
    "build:ios": "node ../../scripts/backend-profile.mjs mobile local -- run:ios",
    "dev": "node ../../scripts/backend-profile.mjs mobile local",
    "dev:local": "node ../../scripts/backend-profile.mjs mobile local",
    "dev:prod-api": "node ../../scripts/backend-profile.mjs mobile prod-api",
    "ios:local": "node ../../scripts/backend-profile.mjs mobile local -- run:ios",
    "ios:prod-api": "node ../../scripts/backend-profile.mjs mobile prod-api -- run:ios",
    "android:local": "node ../../scripts/backend-profile.mjs mobile local -- run:android",
    "android:prod-api": "node ../../scripts/backend-profile.mjs mobile prod-api -- run:android",
    "ios": "node ../../scripts/backend-profile.mjs mobile local -- run:ios",
    "ios:device": "node ../../scripts/backend-profile.mjs mobile local -- run:ios --device \"Deez iPhone\" --configuration Debug",
    "lint": "biome check .",
    "test:realtime": "bun run --cwd ../../packages/timer test:realtime",
    "skia:web": "setup-skia-web public",
    "typecheck": "tsc --noEmit",
    "web": "node ../../scripts/backend-profile.mjs mobile local -- start --web"
  },
