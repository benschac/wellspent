{
  "expo": {
    "name": "Timer",
    "slug": "timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "timer",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.benschac.timer"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.benschac.timer"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./modules/timer-live-activity/app.plugin.js",
      "./plugins/with-timer-widget-actions",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TimerWidget",
              "displayName": "Timer",
              "description": "See and control the shared timer.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-maps",
      "expo-image",
      "expo-font",
      "expo-background-task",
      "expo-audio",
      "expo-sqlite",
      "expo-status-bar",
      "expo-asset"
    ]
  }
}
