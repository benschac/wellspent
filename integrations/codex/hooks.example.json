{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/ABSOLUTE/PATH/TO/timer/integrations/codex/timer-capture.mjs' capture",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/ABSOLUTE/PATH/TO/timer/integrations/codex/timer-capture.mjs' capture",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
