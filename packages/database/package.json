{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate --prefix supabase",
    "db:migrate:local": "bunx supabase@2.116.0 migration up --workdir ../.. --db-url 'postgresql://postgres:postgres@127.0.0.1:54422/postgres?sslmode=disable&connect_timeout=30'",
    "db:reset:local": "bunx supabase@2.116.0 db reset --workdir ../.. --db-url 'postgresql://postgres:postgres@127.0.0.1:54422/postgres?sslmode=disable&connect_timeout=30'",
    "db:studio": "drizzle-kit studio",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "typescript": "~6.0.3"
  }
}
