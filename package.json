{
  "name": "timer-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "workspaces": [
    "apps/*",
    "integrations/*",
    "packages/*"
  ],
  "scripts": {
    "android:device": "bash ./scripts/android-device.sh",
    "build": "turbo run build",
    "build:ios": "bun run --cwd apps/mobile build:ios",
    "db:check": "turbo run db:check --filter=@repo/database",
    "db:generate": "turbo run db:generate --filter=@repo/database",
    "db:migrate": "bun run db:migrate:local",
    "db:migrate:local": "turbo run db:migrate:local --filter=@repo/database",
    "db:reset:local": "turbo run db:reset:local --filter=@repo/database",
    "db:studio": "turbo run db:studio --filter=@repo/database",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ios:device": "bun run --cwd apps/mobile ios:device",
    "knip": "turbo run knip:check --",
    "knip:check": "knip",
    "lint": "turbo run lint",
    "skia:web": "turbo run skia:web",
    "supabase:start": "bun run supabase:start:full",
    "supabase:start:lite": "bunx supabase@2.116.0 start --exclude realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector",
    "supabase:start:full": "bunx supabase@2.116.0 start --exclude logflare,vector,imgproxy",
    "supabase:status": "bunx supabase@2.116.0 status",
    "supabase:stop": "bunx supabase@2.116.0 stop",
    "test": "turbo run test",
    "test:profiles": "node --test scripts/backend-profile.test.mjs scripts/macos-auth-configuration.test.mjs",
    "test:capture": "turbo run test:capture",
    "test:fast": "turbo run test:focus test:capture",
    "test:focus": "turbo run test:focus",
    "test:focus:db:local": "turbo run test:focus:db:local",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.4.0",
    "effect": "4.0.0-rc.112",
    "knip": "6.35.1",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  }
}
