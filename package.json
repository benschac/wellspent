{
  "name": "timer-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "android:device": "bash ./scripts/android-device.sh",
    "build": "turbo run build",
    "build:ios": "bun run --cwd apps/mobile build:ios",
    "db:check": "turbo run db:check --filter=@repo/database",
    "db:generate": "turbo run db:generate --filter=@repo/database",
    "db:migrate": "bun run db:migrate:local",
    "db:migrate:local": "turbo run db:migrate:local --filter=@repo/database",
    "db:reset:local": "turbo run db:reset:local --filter=@repo/database",
    "db:studio": "turbo run db:studio --filter=@repo/database",
    "dev": "turbo run dev",
    "ios:device": "bun run --cwd apps/mobile ios:device",
    "lint": "turbo run lint",
    "skia:web": "turbo run skia:web",
    "supabase:start": "bunx supabase@2.116.0 start --exclude realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector",
    "supabase:start:full": "bunx supabase@2.116.0 start --exclude logflare,vector,imgproxy",
    "supabase:status": "bunx supabase@2.116.0 status",
    "supabase:stop": "bunx supabase@2.116.0 stop",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
