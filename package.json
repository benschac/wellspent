{
  "name": "timer-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "db:check": "turbo run db:check --filter=@repo/database",
    "db:generate": "turbo run db:generate --filter=@repo/database",
    "db:migrate": "turbo run db:migrate --filter=@repo/database",
    "db:studio": "turbo run db:studio --filter=@repo/database",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
