{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "//#knip:check": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "skia:web"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "db:check": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate:local": {
      "cache": false
    },
    "db:reset:local": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "env": ["DATABASE_URL"],
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
    },
    "skia:web": {
      "outputs": ["public/canvaskit.wasm"]
    },
    "test": {
      "cache": false
    },
    "test:focus": {
      "cache": false
    },
    "test:capture": {
      "cache": false
    },
    "test:focus:db:local": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    }
  }
}
